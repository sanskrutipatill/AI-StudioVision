# StudioVision AI - Environment Variables
# Copy this file to .env.local and populate the values

# Next.js App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Configuration
# Obtain these from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Gemini API Configuration
# Get your API key from Google AI Studio (https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Image Processing Engine
# Background removal & replacement engine (options: "rembg-sharp" (built-in fast sharp engine), "removebg", "clipdrop", "replicate")
IMAGE_PROCESSING_PROVIDER=built-in
REMOVE_BG_API_KEY=
CLIPDROP_API_KEY=

